  .post { max-width: 800px; padding-top: 64px; padding-bottom: 100px; }
  .post-header { margin-bottom: 40px; }
  .post-header h1 {
    font-size: clamp(2rem, 4.2vw, 2.8rem);
    margin: 14px 0 16px;
  }
  .post-dek {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--paper-dim);
    margin: 0 0 14px;
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    color: var(--paper-faint);
    margin: 0;
  }
  .post-meta-link {
    color: var(--signal-bright);
    border-bottom: 1px solid var(--signal);
  }

  .post-image {
    display: block;
    width: 100%;
    max-width: 68ch;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: #fff;
    margin: 0 0 34px;
  }
  .post-image-lead { max-width: 100%; margin-bottom: 44px; }

  .inline-link { color: var(--signal-bright); border-bottom: 1px solid var(--signal); }

  .post-body p {
    font-size: 1.05rem;
    max-width: 68ch;
    margin: 0 0 1.3em;
  }
  .post-body sup a {
    color: var(--signal-bright);
    font-size: 0.75em;
  }

  .post-loop {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--signal-bright);
    background: var(--ink-raised);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 18px 22px;
    max-width: 68ch;
  }

  .post-divider { max-width: 68ch; margin: 40px 0; }

  .post-pullquote {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.35;
    color: var(--paper);
    max-width: 60ch;
    margin: 36px 0;
    padding-left: 20px;
    border-left: 3px solid var(--signal);
  }
  .post-closer {
    margin-top: 48px;
    font-size: 1.6rem;
  }

  .post-footnotes { margin-top: 56px; }
  .post-footnotes ol {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--paper-faint);
    line-height: 1.8;
    padding-left: 20px;
    margin: 24px 0 36px;
  }
  .post-footnotes .inline-link {
    color: var(--signal-bright);
    border-bottom: 1px solid var(--signal);
    word-break: break-all;
  }
  .post-back { display: inline-block; }

  @media (max-width: 720px) {
    .post-pullquote { font-size: 1.2rem; padding-left: 14px; }
    .post-closer { font-size: 1.35rem; }
  }

  .post-body h2 { margin: 48px 0 16px; }
  .post-table-wrap { overflow-x: auto; margin: 28px 0; max-width: 100%; }
  .post-table { border-collapse: collapse; font-size: 0.95rem; line-height: 1.55; width: 100%; }
  .post-table th, .post-table td { text-align: left; vertical-align: top; padding: 12px 14px; border-bottom: 1px solid var(--rule); }
  .post-table th { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--paper-faint); }
  .post-table td:first-child { width: 34%; color: var(--paper); }
  @media (max-width: 720px) {
    .post-table, .post-table tbody, .post-table tr, .post-table td { display: block; width: 100%; }
    .post-table thead { display: none; }
    .post-table tr { border-bottom: 1px solid var(--rule); padding: 12px 0; }
    .post-table td { border: 0; padding: 4px 0; }
    .post-table td:first-child { width: 100%; font-weight: 600; }
  }
  .post-footnotes li { margin-bottom: 6px; }
</style>
